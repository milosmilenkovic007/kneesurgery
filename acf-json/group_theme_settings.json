            ],
            "wrapper": {
                "width": "50"
            }
        },
        {
            "key": "field_zoho_crm_oauth_refresh_token",
            "label": "Zoho OAuth Refresh Token",
            "name": "zoho_crm_oauth_refresh_token",
            "type": "text",
            "instructions": "Optional manual entry. You can generate and save this automatically using the 'Authenticate with Zoho' button in the status box.",
