{
    "key": "group_theme_settings",
    "title": "Theme Settings",
    "fields": [
        {
            "key": "field_branding_settings_tab",
            "label": "Branding",
            "name": "",
            "type": "tab",
            "placement": "top"
        },
        {
            "key": "field_header_logo",
            "label": "Header Logo",
            "name": "header_logo",
            "type": "image",
            "instructions": "Primary logo used in the desktop header. Falls back to Appearance > Customize > Site Identity.",
            "return_format": "id",
            "preview_size": "medium",
            "library": "all",
            "wrapper": {
                "width": "40"
            }
        },
        {
            "key": "field_mobile_logo",
            "label": "Mobile Logo",
            "name": "mobile_logo",
            "type": "image",
            "instructions": "Optional compact logo for mobile. The header logo is used when empty.",
            "return_format": "id",
            "preview_size": "medium",
            "library": "all",
            "wrapper": {
                "width": "40"
            }
        },
        {
            "key": "field_site_favicon",
            "label": "Favicon",
            "name": "site_favicon",
            "type": "image",
            "instructions": "Use a square PNG, ICO or SVG. Recommended size: at least 512 × 512 px.",
            "return_format": "id",
            "preview_size": "thumbnail",
            "library": "all",
            "wrapper": {
                "width": "20"
            }
        },
        {
            "key": "field_header_logo_width",
            "label": "Desktop Logo Width",
            "name": "header_logo_width",
            "type": "number",
            "append": "px",
            "default_value": 210,
            "min": 80,
            "max": 500,
            "step": 1,
            "wrapper": {
                "width": "25"
            }
        },
        {
            "key": "field_mobile_logo_width",
