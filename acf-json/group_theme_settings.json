            "choices": {
                "Manrope": "Manrope",
                "Inter": "Inter",
                "Roboto": "Roboto",
                "Open Sans": "Open Sans",
                "Lato": "Lato",
                "Poppins": "Poppins",
                "Source Serif 4": "Source Serif 4",
                "System UI": "System UI",
                "Georgia": "Georgia"
