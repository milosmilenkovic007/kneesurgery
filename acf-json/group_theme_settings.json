            "type": "text",
            "default_value": "https://accounts.zoho.com",
            "instructions": "Examples: https://accounts.zoho.com, https://accounts.zoho.eu",
            "conditional_logic": [
                [
                    {
                        "field": "field_zoho_crm_enabled",
                        "operator": "==",
                        "value": "1"
                    }
                ]
            ],
            "wrapper": {
                "width": "50"
            }
        },
        {
            "key": "field_zoho_crm_oauth_client_id",
